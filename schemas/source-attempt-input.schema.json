{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "space-watch-source-attempt-input-v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission_id", "acquisition_mode", "source_acquisition_effect", "project_effect", "attempts"],
  "properties": {
    "schema_version": {"const": "space-watch-source-attempt-input-v0.2"},
    "mission_id": {"type": "string", "minLength": 1},
    "acquisition_mode": {"const": "synthetic_fixture"},
    "source_acquisition_effect": {"const": false},
    "project_effect": {"const": "none"},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "claim_family", "carrier_class", "attempted_at", "status", "attempt_count", "login_used", "retry_used", "alternate_carrier_used", "projection_schema", "typed_content", "limitations"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "claim_family": {"type": "string", "minLength": 1},
          "carrier_class": {"const": "synthetic_fixture"},
          "attempted_at": {"type": "string", "format": "date-time"},
          "status": {"enum": ["available", "partial", "unavailable"]},
          "attempt_count": {"const": 1},
          "login_used": {"const": false},
          "retry_used": {"const": false},
          "alternate_carrier_used": {"const": false},
          "projection_schema": {"type": "string", "minLength": 1},
          "typed_content": {"type": ["object", "null"]},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "available"}}, "required": ["status"]},
            "then": {"properties": {"typed_content": {"type": "object"}}}
          },
          {
            "if": {"properties": {"status": {"const": "unavailable"}}, "required": ["status"]},
            "then": {"properties": {"typed_content": {"type": "null"}}}
          }
        ]
      }
    }
  }
}
